module top_demo (
  clk,
  rst_n,
  uart_rx,
  uart_tx,
  led,
  dbg_round,
  dbg_busy
)
;
input clk;
input rst_n;
input uart_rx;
output uart_tx;
output [3:0] led;
output [3:0] dbg_round;
output dbg_busy;
wire clk_d;
wire rst_n_d;
wire uart_rx_d;
wire led_d_0_4;
wire led_d_1_4;
wire dbg_busy_d_4;
wire aes_result_valid;
wire n2295_6;
wire rx_valid_Z;
wire tx_ready_Z;
wire uart_tx_d;
wire cmd_start_Z;
wire cmd_init_Z;
wire cmd_is_encrypt_Z;
wire tx_valid_Z;
wire [2:2] led_d;
wire [3:0] dbg_round_d;
wire [127:0] aes_result;
wire [7:0] rx_data_Z;
wire [127:0] cmd_block;
wire [7:0] tx_data_Z;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  IBUF uart_rx_ibuf (
    .O(uart_rx_d),
    .I(uart_rx) 
);
  OBUF uart_tx_obuf (
    .O(uart_tx),
    .I(uart_tx_d) 
);
  OBUF led_0_obuf (
    .O(led[0]),
    .I(led_d_0_4) 
);
  OBUF led_1_obuf (
    .O(led[1]),
    .I(led_d_1_4) 
);
  OBUF led_2_obuf (
    .O(led[2]),
    .I(led_d[2]) 
);
  OBUF led_3_obuf (
    .O(led[3]),
    .I(GND) 
);
  OBUF dbg_round_0_obuf (
    .O(dbg_round[0]),
    .I(dbg_round_d[0]) 
);
  OBUF dbg_round_1_obuf (
    .O(dbg_round[1]),
    .I(dbg_round_d[1]) 
);
  OBUF dbg_round_2_obuf (
    .O(dbg_round[2]),
    .I(dbg_round_d[2]) 
);
  OBUF dbg_round_3_obuf (
    .O(dbg_round[3]),
    .I(dbg_round_d[3]) 
);
  OBUF dbg_busy_obuf (
    .O(dbg_busy),
    .I(dbg_busy_d_4) 
);
  INV led_d_0_s0 (
    .O(led_d_0_4),
    .I(uart_rx_d) 
);
  INV led_d_1_s0 (
    .O(led_d_1_4),
    .I(uart_tx_d) 
);
  INV dbg_busy_d_s0 (
    .O(dbg_busy_d_4),
    .I(led_d[2]) 
);
  aes_core_tapped u_aes (
    .clk_d(clk_d),
    .cmd_is_encrypt_Z(cmd_is_encrypt_Z),
    .cmd_start_Z(cmd_start_Z),
    .cmd_init_Z(cmd_init_Z),
    .rst_n_d(rst_n_d),
    .cmd_block(cmd_block[127:0]),
    .aes_result_valid(aes_result_valid),
    .n2295_6(n2295_6),
    .led_d(led_d[2]),
    .dbg_round_d(dbg_round_d[3:0]),
    .aes_result(aes_result[127:0])
);
  uart_rx u_uart_rx (
    .uart_rx_d(uart_rx_d),
    .clk_d(clk_d),
    .n2295_6(n2295_6),
    .rx_valid_Z(rx_valid_Z),
    .rx_data_Z(rx_data_Z[7:0])
);
  uart_tx u_uart_tx (
    .clk_d(clk_d),
    .n2295_6(n2295_6),
    .tx_valid_Z(tx_valid_Z),
    .tx_data_Z(tx_data_Z[7:0]),
    .tx_ready_Z(tx_ready_Z),
    .uart_tx_d(uart_tx_d)
);
  uart_cmd_fsm u_cmd (
    .clk_d(clk_d),
    .n2295_6(n2295_6),
    .rst_n_d(rst_n_d),
    .tx_ready_Z(tx_ready_Z),
    .rx_valid_Z(rx_valid_Z),
    .aes_result_valid(aes_result_valid),
    .rx_data_Z(rx_data_Z[7:0]),
    .aes_result(aes_result[127:0]),
    .led_d(led_d[2]),
    .cmd_start_Z(cmd_start_Z),
    .cmd_init_Z(cmd_init_Z),
    .cmd_is_encrypt_Z(cmd_is_encrypt_Z),
    .tx_valid_Z(tx_valid_Z),
    .cmd_block(cmd_block[127:0]),
    .tx_data_Z(tx_data_Z[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
