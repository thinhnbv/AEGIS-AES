//---------------------------------------------------------------
// acg525.cst
// Constraint file for ACG525 board (GW5A-25)
// GW5A-LV25UG324C2-I1
//---------------------------------------------------------------

// NOTE: Assign pins manually in Gowin I/O Constraints Editor
// Only essential signals are listed here

// Clock input (50MHz)
IO_LOC "clk" P5;
IO_PORT "clk" PULL_MODE=UP;

// Reset button
IO_LOC "rst_n" M9;
IO_PORT "rst_n" PULL_MODE=UP;

// UART interface
IO_LOC "uart_rx" T3;
IO_PORT "uart_rx" PULL_MODE=UP;

IO_LOC "uart_tx" R3;
IO_PORT "uart_tx" PULL_MODE=UP;

// Status LEDs
IO_LOC "led[0]" J1;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8;

IO_LOC "led[1]" J2;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8;

IO_LOC "led[2]" H1;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8;

IO_LOC "led[3]" K1;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8;
