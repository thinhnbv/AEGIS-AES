//---------------------------------------------------------------
// acg525.pin
// Pin assignment file for ACG525 board (GW5A-25)
// GW5A-LV25UG324C2-I1
//---------------------------------------------------------------

// System signals
clk         T9      // 50MHz system clock input (CLK_G)
rst_n       B16     // Reset button (KEY0)

// UART interface
uart_rx     U8      // UART receive
uart_tx     V8      // UART transmit

// Status LEDs
led[0]      D14     // LED0
led[1]      C14     // LED1
led[2]      B9      // LED2
led[3]      A9      // LED3
