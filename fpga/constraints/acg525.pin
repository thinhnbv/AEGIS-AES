//---------------------------------------------------------------
// acg525.pin
// Pin assignment file for ACG525 board (GW5A-25)
// GW5A-LV25UG324C2-I1
//---------------------------------------------------------------

// System signals
clk         P5      // 50MHz system clock input
rst_n       M9      // Active-low reset (button)

// UART interface
uart_rx     T3      // UART receive
uart_tx     R3      // UART transmit

// Status LEDs
led[0]      J1      // RX activity
led[1]      J2      // TX activity
led[2]      H1      // AES idle
led[3]      K1      // Reserved

// Debug outputs (for testing)
dbg_round[0]    K2
dbg_round[1]    L1
dbg_round[2]    L2
dbg_round[3]    M1
dbg_busy        M2
