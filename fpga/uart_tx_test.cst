// Constraints for uart_tx_test
// Pin assignments based on actual board testing

IO_LOC "clk" T9;
IO_PORT "clk" PULL_MODE=UP;

IO_LOC "rst_n" B16;
IO_PORT "rst_n" PULL_MODE=UP;

IO_LOC "uart_rx" U8;
IO_PORT "uart_rx" PULL_MODE=UP;

IO_LOC "uart_tx" V8;
IO_PORT "uart_tx" PULL_MODE=UP DRIVE=8;

// LED0 on D14 (actual board - was labeled LED1)
IO_LOC "led_rx" D14;
IO_PORT "led_rx" PULL_MODE=UP DRIVE=8;

// LED1 on C14 (actual board - was labeled LED0)
IO_LOC "led_tx" C14;
IO_PORT "led_tx" PULL_MODE=UP DRIVE=8;
