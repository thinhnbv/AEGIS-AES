//-----------------------------------------------------------------
// aegis_cfg_reader.vh
//
// Shared helper to read a case-contract config file (verif/cfg/<CASE>.cfg,
// generated by scripts/gen_case_cfg.py from ground_truth.yaml) at runtime.
//
// The parser is byte-wise ($fgetc) and deliberately avoids $sscanf:
// Icarus parses a packed string with $sscanf, but Verilator returns 0 for
// every field on a dynamic string, which silently zeroed the expected_mask
// under SIM=verilator. This reader behaves identically on both simulators.
//
// Fields read:
//   expected_mask            (hex)  detector bitmask that must fire
//   expected_latency_cycles  (int)  cycle budget, -1 for free-form prose
//   silent_under_nist       (bool) whether the Trojan must stay silent on
//                                   clean NIST traffic
//   trigger_repeat           (int)  how many times the trigger is sent
//
// Usage:
//   `include "aegis_cfg_reader.vh"
//   integer m, lat, rep, ok; logic sil;
//   aegis_cfg_read("verif/cfg/T01_p1_key_dump.cfg", m, lat, sil, rep, ok);
//
// cfg_ok = 1 when the file opened, 0 otherwise.
//
// NOTE: a task (not a function) because Icarus only allows output ports on
// tasks reliably.
//-----------------------------------------------------------------
`ifndef AEGIS_CFG_READER_VH
`define AEGIS_CFG_READER_VH

task automatic aegis_cfg_read;
  input  string      path;
  output reg [7:0]   expected_mask;
  output integer     expected_latency;
  output reg         silent_under_nist;
  output integer     trigger_repeat;
  output integer     cfg_ok;

  integer      fd, c, i, n, eqpos, klen, vs, val, neg;
  reg [7:0]    ln [0:255];    // current line, byte 0 at index 0

  begin
    expected_mask     = 8'd0;
    expected_latency  = -1;
    silent_under_nist = 1'b1;
    trigger_repeat    = 1;
    cfg_ok            = 0;

    fd = $fopen(path, "r");

    if (fd == 0) begin
      $display("[CFG] Khong mo duoc file config: %0s", path);
    end
    else begin
      // Read the whole file one byte at a time; parse one line at each
      // newline. ln[0..n-1] holds the current line.
      n = 0;
      c = $fgetc(fd);

      // $fgetc returns -1 on end-of-file (SV spec, honored by both
      // simulators here). 0x00 cannot appear in the ASCII .cfg format.
      while ((c != 0) && (c != -1)) begin
        if (c == 10 || c == 13) begin
          // ---- parse the "key = value" line in ln[0..n-1] ----
          eqpos = -1;
          for (i = 0; i < n; i = i + 1)
            if (ln[i] == 61) eqpos = i;   // position of '='

          if (eqpos > 0) begin
            klen = eqpos;                  // key length == position of '='
            vs = eqpos + 1;               // value starts here
            while (vs < n && ln[vs] == 32) vs = vs + 1;   // skip spaces

            // Keys are uniquely identified by (first byte, key length):
            //   'e'(101) + 14 = "expected_mask"
            //   'e'(101) + 24 = "expected_latency_cycles"
            //   's'(115) + 18 = "silent_under_nist"
            //   't'(116) + 15 = "trigger_repeat"
            if ((ln[0] == 101) && (klen == 14)) begin
              // expected_mask = <hex>
              val = 0;
              for (i = vs; i < n; i = i + 1) begin
                case (ln[i])
                  48:  val = val*16 + 0;
                  49:  val = val*16 + 1;
                  50:  val = val*16 + 2;
                  51:  val = val*16 + 3;
                  52:  val = val*16 + 4;
                  53:  val = val*16 + 5;
                  54:  val = val*16 + 6;
                  55:  val = val*16 + 7;
                  56:  val = val*16 + 8;
                  57:  val = val*16 + 9;
                  97:  val = val*16 + 10;
                  98:  val = val*16 + 11;
                  99:  val = val*16 + 12;
                  100: val = val*16 + 13;
                  101: val = val*16 + 14;
                  102: val = val*16 + 15;
                  65:  val = val*16 + 10;
                  66:  val = val*16 + 11;
                  67:  val = val*16 + 12;
                  68:  val = val*16 + 13;
                  69:  val = val*16 + 14;
                  70:  val = val*16 + 15;
                  default: ;
                endcase
              end
              expected_mask = val[7:0];

            end
            else if ((ln[0] == 101) && (klen == 24)) begin
              // expected_latency_cycles = <signed int> (usually -1)
              val = 0; neg = 0;
              if (ln[vs] == 45) begin
                neg = 1;
                vs = vs + 1;
              end
              for (i = vs; i < n; i = i + 1)
                if (ln[i] >= 48 && ln[i] <= 57)
                  val = val*10 + (ln[i] - 48);
              expected_latency = neg ? -val : val;

            end
            else if ((ln[0] == 115) && (klen == 18)) begin
              // silent_under_nist = true|false  -> 't'(116) of "true"
              silent_under_nist = (ln[vs] == 116);

            end
            else if ((ln[0] == 116) && (klen == 15)) begin
              // trigger_repeat = <int>
              val = 0;
              for (i = vs; i < n; i = i + 1)
                if (ln[i] >= 48 && ln[i] <= 57)
                  val = val*10 + (ln[i] - 48);
              trigger_repeat = val;
            end
          end
          n = 0;
        end
        else begin
          ln[n] = c[7:0];
          n = n + 1;
        end

        c = $fgetc(fd);
      end

      $fclose(fd);
      cfg_ok = 1;

      $display("[CFG] %0s: expected_mask=%08b latency=%0d silent=%0s repeat=%0d",
               path, expected_mask, expected_latency,
               silent_under_nist ? "true" : "false", trigger_repeat);
    end
  end
endtask

`endif
