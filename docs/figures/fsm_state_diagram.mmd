stateDiagram-v2
    [*] --> IDLE: reset

    state IDLE {
        [*] --> idle
        idle --> idle: !key_valid
        idle --> WAIT_KEY_BUSY: key_valid
    }

    IDLE --> WAIT_KEY_BUSY: key_valid & key_valid

    state WAIT_KEY_BUSY {
        [*] --> wait_busy
        wait_busy --> wait_busy: core_ready
        wait_busy --> WAIT_KEY_DONE: !core_ready
    }

    WAIT_KEY_BUSY --> WAIT_KEY_DONE: !core_ready

    state WAIT_KEY_DONE {
        [*] --> wait_done
        wait_done --> wait_done: !core_ready
        wait_done --> READY: core_ready
    }

    WAIT_KEY_DONE --> READY: core_ready

    state READY {
        [*] --> ready
        ready --> ready: !key_valid & !data_in_valid
        ready --> WAIT_KEY_BUSY: key_valid
        ready --> WAIT_RESULT_LOW: data_in_valid
    }

    READY --> WAIT_KEY_BUSY: key_valid
    READY --> WAIT_RESULT_LOW: data_in_valid

    state WAIT_RESULT_LOW {
        [*] --> wait_low
        wait_low --> wait_low: core_dvalid
        wait_low --> WAIT_RESULT_HIGH: !core_dvalid
    }

    WAIT_RESULT_LOW --> WAIT_RESULT_HIGH: !core_dvalid

    state WAIT_RESULT_HIGH {
        [*] --> wait_high
        wait_high --> wait_high: !core_dvalid
        wait_high --> READY: core_dvalid
    }

    WAIT_RESULT_HIGH --> READY: core_dvalid

    note right of IDLE: Chờ key_valid<br/>Load key vào key_reg<br/>Phát init signal
    note right of READY: Trạng thái ổn định<br/>Nhận key mới hoặc data
    note right of WAIT_RESULT_HIGH: Đợi AES hoàn thành<br/>Sample core_result_new
