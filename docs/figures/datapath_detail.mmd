%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '14px'}}}%%
flowchart LR
    subgraph INPUT["📥 INPUT INTERFACE"]
        K_IN["KEY_IN<br/>[127:0]"]
        D_IN["DATA_IN<br/>[127:0]"]
        KV["key_valid"]
        DV["data_in_valid"]
    end

    subgraph REGS["📝 DATA REGISTERS"]
        K_REG["Key Register<br/>[127:0]"]
        B_REG["Block Register<br/>[127:0]"]
    end

    subgraph AES_CORE["🔐 AES-128 DATAPATH"]
        direction TB
        subgraph EXPAND["🔑 Key Expansion (11 rounds)"]
            K_MEM["Key Memory<br/>key_mem[0:10]<br/>1408 bits"]
        end

        subgraph ROUNDS["⚡ 10 Encryption Rounds"]
            R0["Round 0<br/>AddrKey"]
            R1["Round 1<br/>SB-SR-MC-ARK"]
            R2["Round 2<br/>SB-SR-MC-ARK"]
            R3["Round 3<br/>SB-SR-MC-ARK"]
            R4["Round 4<br/>SB-SR-MC-ARK"]
            R5["Round 5<br/>SB-SR-MC-ARK"]
            R6["Round 6<br/>SB-SR-MC-ARK"]
            R7["Round 7<br/>SB-SR-MC-ARK"]
            R8["Round 8<br/>SB-SR-MC-ARK"]
            R9["Round 9<br/>SB-SR-MC-ARK"]
            R10["Round 10<br/>SB-SR-ARK"]
        end

        ROUNDS_EXPAND["Round 10<br/>(Final - No MixCol)"]
    end

    K_MEM --> R0
    K_MEM --> R1
    K_MEM --> R2
    K_MEM --> R3
    K_MEM --> R4
    K_MEM --> R5
    K_MEM --> R6
    K_MEM --> R7
    K_MEM --> R8
    K_MEM --> R9
    K_MEM --> R10

    subgraph SECURITY["🛡️ SECURITY MONITORS"]
        KLG["🔍 KLG<br/>Key Leak Guard"]
        RCM["📏 RCM<br/>Round Counter"]
        ORC["✅ ORC<br/>Output Checker"]
    end

    subgraph OUTPUT["📤 OUTPUT"]
        D_OUT["DATA_OUT<br/>[127:0]"]
        DOV["data_out_valid"]
        BUSY["BUSY"]
    end

    %% Input connections
    K_IN --> K_REG
    D_IN --> B_REG
    KV -->|init| K_MEM
    DV -->|next| R1

    %% Register to Datapath
    K_REG -->|key| K_MEM
    B_REG -->|block| R0

    %% Round outputs
    R10 -->|ciphertext| D_OUT
    R10 -->|result_valid| DOV

    %% Security monitoring points
    K_MEM -->|round_keys_flat<br/>1408 bits| KLG
    R1 -->|round_nr| RCM
    R9 -->|state_before_final| ORC
    K_MEM -->|final_round_key| ORC
    R10 -->|core_dout| ORC
    R10 -->|core_result| KLG

    style INPUT fill:#E8F5E9,stroke:#2E7D32
    style REGS fill:#F3E5F5,stroke:#7B1FA2
    style AES_CORE fill:#E3F2FD,stroke:#1565C0
    style SECURITY fill:#FFF8E1,stroke:#F57F17,stroke-width:3px
    style OUTPUT fill:#FFEBEE,stroke:#C62828
