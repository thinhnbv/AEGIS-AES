        <!-- AES Core main box -->
        <mxCell id="aes-core-box" value="aes_core_tapped.v" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#009933;fillColor=#E6FFE6;fontSize=14;fontStyle=1;fontColor=#006600;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="880" y="160" width="280" height="490" as="geometry"/>
        </mxCell>

        <!-- Control FSM in AES -->
        <mxCell id="aes-ctrl" value="Control FSM&#xa;─────────────&#xa;IDLE → INIT (key)&#xa;    ↓ (key_ready)&#xa;IDLE → NEXT&#xa;    ↓ (ready)&#xa;IDLE" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#009933;fillColor=#DDFFDD;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="900" y="180" width="110" height="90" as="geometry"/>
        </mxCell>

        <!-- Key Memory -->
        <mxCell id="key-mem-mod" value="aes_key_mem_tapped.v&#xa;═══════════════════&#xa;• Key expansion&#xa;  (128b → 1408b)&#xa;• 11 round keys&#xa;• Round scheduler&#xa;&#xa;Tapped:&#xa;• sboxw&#xa;• round_keys_flat" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#009933;fillColor=#DDFFDD;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="900" y="290" width="130" height="120" as="geometry"/>
        </mxCell>

        <!-- Encrypt Block -->
        <mxCell id="enc-mod" value="aes_encipher_block&#xa;_tapped.v&#xa;═══════════════════&#xa;Encrypt Pipeline&#xa;&#xa;Round 0:&#xa;  AddRoundKey&#xa;&#xa;Round 1-9:&#xa;  SubBytes&#xa;  → ShiftRows&#xa;  → MixColumns&#xa;  → AddRoundKey&#xa;&#xa;Round 10:&#xa;  SubBytes&#xa;  → ShiftRows&#xa;  → AddRoundKey&#xa;&#xa;Tap: state_before_final" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#0066CC;fillColor=#E6F3FF;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1040" y="180" width="110" height="200" as="geometry"/>
        </mxCell>

        <!-- Decrypt Block -->
        <mxCell id="dec-mod" value="aes_decipher&#xa;_block.v&#xa;═════════════&#xa;Decrypt Pipeline&#xa;&#xa;Inverse:&#xa;• InvSubBytes&#xa;• InvShiftRows&#xa;• InvMixColumns&#xa;• InvAddRoundKey" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#CC0000;fillColor=#FFE6E6;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="1040" y="400" width="110" height="100" as="geometry"/>
        </mxCell>

        <!-- S-Box -->
        <mxCell id="sbox-mod" value="aes_sbox.v&#xa;═══════════&#xa;256-byte ROM&#xa;&#xa;• Forward S-Box&#xa;• Inverse S-Box&#xa;&#xa;Shared between:&#xa;• Key expansion&#xa;• Encrypt&#xa;• Decrypt" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#9933FF;fillColor=#F3E6FF;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
