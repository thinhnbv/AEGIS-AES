        <mxCell id="top-module" value="top_demo.v" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#1F4E79;fillColor=#FFFFFF;fontSize=14;fontStyle=1;fontColor=#1F4E79;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="100" width="700" height="640" as="geometry"/>
        </mxCell>

        <!-- ========== UART RX MODULE ========== -->
        <mxCell id="uart-rx-module" value="uart_rx.v&#xa;═══════════════════&#xa;• 8N1 Protocol&#xa;• 115200 baud&#xa;• 50MHz clock&#xa;&#xa;States:&#xa;IDLE → START → DATA → STOP" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#0066CC;fillColor=#E6F3FF;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="140" width="180" height="160" as="geometry"/>
        </mxCell>

        <!-- ========== UART TX MODULE ========== -->
        <mxCell id="uart-tx-module" value="uart_tx.v&#xa;═══════════════════&#xa;• 8N1 Protocol&#xa;• 115200 baud&#xa;• 50MHz clock&#xa;&#xa;States:&#xa;IDLE → START → DATA → STOP" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#CC0000;fillColor=#FFE6E6;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="520" width="180" height="160" as="geometry"/>
        </mxCell>

        <!-- ========== COMMAND FSM MODULE ========== -->
        <mxCell id="cmd-fsm-module" value="uart_cmd_fsm.v&#xa;═══════════════════════════════════════&#xa;Command Protocol: PC → FPGA (36 bytes)&#xa;─────────────────────────────────────────&#xa;[0]     0x01 (cmd marker)&#xa;[1]     mode (0=decrypt, 1=encrypt)&#xa;[2:17]  16 bytes key&#xa;[18:33] 16 bytes block data&#xa;[34]    checksum (XOR)&#xa;[35]    0xAA (end marker)&#xa;&#xa;FSM States:&#xa;IDLE → RECV_CMD → INIT_KEY → WAIT_READY → EXEC → SEND_RESP" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#FF6600;fillColor=#FFF2E6;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="420" height="200" as="geometry"/>
        </mxCell>

        <!-- Buffers in CMD FSM -->
        <mxCell id="rx-buf-box" value="rx_buf[0:33]&#xa;34 bytes" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#FF6600;fillColor=#FFFACD;fontSize=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="280" width="90" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="tx-buf-box" value="tx_buf[0:36]&#xa;37 bytes" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#FF6600;fillColor=#FFFACD;fontSize=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="180" width="90" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== AES CORE MODULE ========== -->
        <mxCell id="aes-core-module" value="aes_core_tapped.v (Security Core)&#xa;═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#009933;fillColor=#E6FFE6;fontSize=12;fontStyle=1;fontColor=#006600;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="380" width="620" height="340" as="geometry"/>
        </mxCell>

        <!-- AES Control FSM -->
        <mxCell id="aes-ctrl-box" value="Control FSM&#xa;─────────────────&#xa;IDLE → INIT (key) → IDLE&#xa;         ↓&#xa;       NEXT → IDLE" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#009933;fillColor=#CCFFCC;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="420" width="140" height="90" as="geometry"/>
        </mxCell>

        <!-- Key Memory -->
        <mxCell id="key-mem-box" value="aes_key_mem_tapped.v&#xa;═══════════════════&#xa;• Key expansion (256→1408 bits)&#xa;• 11 round keys (128 bits each)&#xa;• Round key scheduler&#xa;&#xa;Tapped for RCM/ORC debug" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#009933;fillColor=#DDFFDD;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="160" height="140" as="geometry"/>
        </mxCell>

        <!-- Encrypt Block -->
        <mxCell id="enc-block-box" value="aes_encipher_block_tapped.v&#xa;═════════════════════════════&#xa;Encrypt Datapath&#xa;&#xa;Round 0: AddRoundKey&#xa;Round 1-9:&#xa;  SubBytes → ShiftRows&#xa;  → MixColumns → AddRoundKey&#xa;Round 10:&#xa;  SubBytes → ShiftRows&#xa;  → AddRoundKey (no MixCol)&#xa;&#xa;Tapped: state_before_final" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#0066CC;fillColor=#E6F3FF;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="420" width="180" height="180" as="geometry"/>
        </mxCell>

        <!-- Decrypt Block -->
        <mxCell id="dec-block-box" value="aes_decipher_block.v&#xa;═════════════════════&#xa;Decrypt Datapath&#xa;&#xa;Inverse operations:&#xa;• InvSubBytes&#xa;• InvShiftRows&#xa;• InvMixColumns&#xa;• InvAddRoundKey" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#CC0000;fillColor=#FFE6E6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="620" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- S-Box -->
        <mxCell id="sbox-box" value="aes_sbox.v&#xa;───────────&#xa;256-byte ROM&#xa;Forward &amp;&#xa;Inverse S-Box" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#9933FF;fillColor=#F3E6FF;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
