          <mxGeometry x="290" y="500" width="140" height="150" as="geometry"/>
        </mxCell>

        <!-- ========== COMMAND FSM ========== -->
        <mxCell id="cmd-fsm-label" value="Command FSM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#FF6600;" vertex="1" parent="1">
          <mxGeometry x="530" y="130" width="100" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="cmd-fsm-mod" value="uart_cmd_fsm.v&#xa;═══════════════════════════════════&#xa;&#xa;PC → FPGA (36 bytes):&#xa;────────────────────────────────&#xa;[0]     0x01 (cmd marker)&#xa;[1]     mode (0=dec, 1=enc)&#xa;[2:17]  16 bytes key&#xa;[18:33] 16 bytes block&#xa;[34]    checksum (XOR)&#xa;[35]    0xAA (end)&#xa;&#xa;FPGA → PC (37 bytes):&#xa;────────────────────────────────&#xa;[0]     0x02 (response)&#xa;[1]     status&#xa;[2:17]  result&#xa;[18:33] echoed block&#xa;[34]    checksum&#xa;[35]    0xBB&#xa;[36]    round counter" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#FF6600;fillColor=#FFF2E6;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="160" width="250" height="220" as="geometry"/>
        </mxCell>

        <!-- FSM States Box -->
        <mxCell id="fsm-states" value="FSM States:&#xa;─────────────&#xa;IDLE → RECV_CMD&#xa;     ↓&#xa;INIT_KEY&#xa;     ↓&#xa;WAIT_READY&#xa;     ↓&#xa;EXEC&#xa;     ↓&#xa;SEND_RESP&#xa;     ↓&#xa;(ERR_CHKSUM)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#FF6600;fillColor=#FFFACD;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="740" y="160" width="120" height="140" as="geometry"/>
        </mxCell>

        <!-- Buffers -->
        <mxCell id="rx-buf" value="rx_buf[0:33]&#xa;34 bytes" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#FF6600;fillColor=#FFFACD;fontSize=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="480" y="400" width="100" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="tx-buf" value="tx_buf[0:36]&#xa;37 bytes" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;strokeColor=#FF6600;fillColor=#FFFACD;fontSize=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="400" width="100" height="35" as="geometry"/>
